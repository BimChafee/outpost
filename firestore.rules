rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules, then Publish.
// The household code is the shared secret: you can open a household only if you know its code,
// and households can't be listed or enumerated. Every phone signs in anonymously first.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{hid} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;

      // groceries, ledger, upkeep, devices
      match /{coll}/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && coll != 'meta'
                     && exists(/databases/$(database)/documents/households/$(hid));
      }
      // meta/schedule and meta/notifier are written only by the notifier (admin SDK bypasses rules)
    }
  }
}
